import sys

def feasible(x, y):
    lo, hi = min(x, y), max(x, y)
    return hi <= 2 * (lo + 1)

def main():
    data = sys.stdin.read().split()
    idx = 0
    t = int(data[idx]); idx += 1
    out = []
    for _ in range(t):
        a, b, c, d = (int(data[idx]), int(data[idx+1]), int(data[idx+2]), int(data[idx+3]))
        idx += 4
        half1_ok = feasible(a, b)
        half2_ok = feasible(c - a, d - b)
        out.append("YES" if half1_ok and half2_ok else "NO")
    print("\n".join(out))

if __name__ == "__main__":
    main()